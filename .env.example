# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your Telegram user ID or admin group chat ID (numeric)
ADMIN_CHAT_ID=123456789

# Optional: separate channel/group for automated bot logs (payment alerts, deliveries, UTR failures)
# If not set, logs go to ADMIN_CHAT_ID
LOGS_CHAT_ID=

# Optional: admin contact shown in Support menu (without @)
SUPPORT_HANDLE=your_admin_username

# Optional: path to SQLite database file
DB_PATH=./data/bot.db

# UPI ID for dynamic QR code generation at checkout (all plans + VIP)
UPI_ID=yourname@upi

# Merchant name shown in UPI payment screen
MERCHANT_NAME=Freeflow
